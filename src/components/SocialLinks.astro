---
import Icon from "./Icon.astro";
import { profile } from "../data/profile";

interface Props {
  size?: "sm" | "lg";
}
const { size = "sm" } = Astro.props;

const links = [
  { href: `mailto:${profile.email}`, label: "Email", icon: "mail" as const },
  { href: profile.socials.linkedin, label: "LinkedIn", icon: "linkedin" as const },
  { href: profile.socials.github, label: "GitHub", icon: "github" as const },
  { href: profile.socials.x, label: "X (Twitter)", icon: "x" as const },
];
---

<ul class="flex flex-wrap items-center gap-2">
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-label={link.label}
          title={link.label}
          {...(link.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer me" } : {})}
          class:list={[
            "grid place-items-center rounded-xl border border-border text-muted transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent",
            size === "lg" ? "h-12 w-12" : "h-10 w-10",
          ]}
        >
          <Icon name={link.icon} class={size === "lg" ? "h-5 w-5" : "h-4 w-4"} />
        </a>
      </li>
    ))
  }
</ul>
