---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { url } from "../lib/url";
---

<Layout title="Page not found | Neel Patel">
  <section class="container-page py-32 text-center">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">This page doesn't exist</h1>
    <p class="mt-4 text-muted">It may have moved when the site was rebuilt.</p>
    <a href={url("/")} class="mt-10 inline-flex items-center gap-2 rounded-xl bg-fg px-5 py-3 text-sm font-medium text-bg hover:bg-accent">
      <Icon name="arrow-left" class="h-4 w-4" /> Back home
    </a>
  </section>
</Layout>
