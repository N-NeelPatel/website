---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { url } from "../lib/url";
import { experience, metrics, principles, profile, skills } from "../data/profile";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-60 [background-image:linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] [background-size:56px_56px] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_40%,transparent_100%)]"
      aria-hidden="true"
    >
    </div>
    <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[480px] w-[720px] -translate-x-1/2 rounded-full bg-accent/[0.06] blur-3xl dark:bg-accent/15" aria-hidden="true"></div>

    <div class="container-page pb-20 pt-20 sm:pb-28 sm:pt-28">
      <p class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/60 px-3 py-1 text-xs text-muted backdrop-blur">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60 motion-reduce:hidden"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
        </span>
        Senior Software Engineer at OpenSolar · {profile.location}
      </p>

      <h1 class="mt-7 max-w-4xl text-4xl font-semibold leading-[1.08] tracking-tight sm:text-6xl">
        {profile.name}
        <span class="block text-muted">{profile.headline}.</span>
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">{profile.pitch}</p>

      <ul class="mt-7 flex flex-wrap gap-2">
        {profile.roles.map((role) => <li class="chip text-xs">{role}</li>)}
      </ul>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href="#work"
          class="group inline-flex items-center gap-2 rounded-xl bg-fg px-5 py-3 text-sm font-medium text-bg transition-colors hover:bg-accent"
        >
          See selected work
          <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
        </a>
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex items-center gap-2 rounded-xl border border-border px-5 py-3 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
        >
          Get in touch
        </a>
      </div>
    </div>
  </section>

  <!-- Impact metrics -->
  <section aria-label="Impact" class="container-page">
    <dl class="grid grid-cols-2 overflow-hidden rounded-2xl border border-border bg-border lg:grid-cols-4" style="gap: 1px;">
      {
        metrics.map((m) => (
          <div class="reveal bg-surface p-6 sm:p-7">
            <dt class="sr-only">{m.label}</dt>
            <dd>
              <span class="block font-mono text-2xl font-semibold tracking-tight text-accent sm:text-3xl">{m.value}</span>
              <span class="mt-2 block text-sm leading-snug text-muted">{m.label}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- About -->
  <section class="container-page mt-24 grid gap-10 sm:mt-32 md:grid-cols-[200px_1fr]">
    <p class="eyebrow pt-1.5">About</p>
    <div class="reveal max-w-2xl space-y-5 text-lg leading-relaxed text-fg/90">
      <p>{profile.intro}</p>
      <p class="text-muted">
        My best work sits where business problems meet hard engineering: turning an ambiguous workflow into a reliable system,
        integrating with third parties that fail in creative ways, and making AI agents safe enough to take real actions in
        production.
      </p>
    </div>
  </section>

  <!-- Selected work -->
  <section id="work" class="container-page mt-24 sm:mt-32">
    <div class="flex items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 class="section-title mt-3">Systems I've designed and owned</h2>
      </div>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        work.map((item) => (
          <a
            href={url(`/work/${item.id}/`)}
            class="reveal card group relative flex flex-col p-6 transition-all hover:-translate-y-1 hover:border-accent/60 hover:shadow-[0_8px_40px_-12px] hover:shadow-accent/25 sm:p-7"
          >
            <div class="flex items-center justify-between gap-4 text-xs text-muted">
              <span class="font-mono">{item.data.company} · {item.data.period}</span>
              <Icon name="arrow-up-right" class="h-4 w-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent" />
            </div>
            <h3 class="mt-4 text-lg font-semibold leading-snug tracking-tight">{item.data.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{item.data.summary}</p>
            <dl class="mt-6 grid grid-cols-2 gap-4 border-t border-border pt-5">
              {item.data.metrics.slice(0, 2).map((m) => (
                <div>
                  <dt class="sr-only">{m.label}</dt>
                  <dd>
                    <span class="block font-mono text-lg font-semibold text-fg">{m.value}</span>
                    <span class="text-xs text-muted">{m.label}</span>
                  </dd>
                </div>
              ))}
            </dl>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="container-page mt-24 sm:mt-32">
    <p class="eyebrow">Experience</p>
    <h2 class="section-title mt-3">Where I've done it</h2>

    <ol class="mt-12 space-y-14">
      {
        experience.map((job) => (
          <li class="reveal grid gap-4 md:grid-cols-[200px_1fr] md:gap-10">
            <div class="text-sm text-muted md:pt-1">
              <p class="font-mono">{job.period}</p>
              <p class="mt-1">{job.location}</p>
            </div>
            <div>
              <h3 class="text-lg font-semibold tracking-tight">
                {job.role} <span class="text-muted">· {job.company}</span>
              </h3>
              <p class="mt-2 text-muted">{job.summary}</p>
              <ul class="mt-5 space-y-3">
                {job.points.map((point) => (
                  <li class="relative pl-5 leading-relaxed text-fg/85 before:absolute before:left-0 before:top-[0.7em] before:h-1 before:w-2.5 before:rounded-full before:bg-accent/70">
                    {point}
                  </li>
                ))}
              </ul>
              <ul class="mt-5 flex flex-wrap gap-1.5">
                {job.stack.map((tech) => (
                  <li class="chip">{tech}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Approach -->
  <section id="approach" class="container-page mt-24 sm:mt-32">
    <p class="eyebrow">Approach</p>
    <h2 class="section-title mt-3">How I work</h2>
    <div class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
      {
        principles.map((p, i) => (
          <div class="reveal bg-surface p-6 sm:p-7">
            <p class="font-mono text-xs text-accent">0{i + 1}</p>
            <h3 class="mt-3 font-semibold tracking-tight">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Skills -->
  <section class="container-page mt-24 sm:mt-32">
    <p class="eyebrow">Toolkit</p>
    <h2 class="section-title mt-3">What I build with</h2>
    <dl class="mt-10 divide-y divide-border border-y border-border">
      {
        skills.map((s) => (
          <div class="reveal grid gap-3 py-5 md:grid-cols-[200px_1fr] md:gap-10">
            <dt class="text-sm font-medium text-muted">{s.group}</dt>
            <dd class="flex flex-wrap gap-2">
              {s.items.map((item) => (
                <span class="rounded-lg bg-accent-soft/60 px-2.5 py-1 text-sm">{item}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Contact -->
  <section id="contact" class="container-page mt-24 sm:mt-32">
    <div class="reveal card relative overflow-hidden p-8 sm:p-12">
      <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>
      <p class="eyebrow">Contact</p>
      <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight sm:text-4xl">
        Building something hard with backend or AI at its core?
      </h2>
      <p class="mt-4 max-w-xl text-lg text-muted">
        I'm always happy to talk about agent platforms, integrations, distributed systems and early-stage engineering.
        The fastest way to reach me is email.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-5">
        <a
          href={`mailto:${profile.email}`}
          class="group inline-flex items-center gap-2 rounded-xl bg-fg px-5 py-3 text-sm font-medium text-bg transition-colors hover:bg-accent"
        >
          <Icon name="mail" class="h-4 w-4" />
          {profile.email}
        </a>
        <SocialLinks size="lg" />
      </div>
    </div>
  </section>
</Layout>
